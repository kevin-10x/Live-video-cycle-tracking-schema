# HTTP server
PORT=4100
CORS_ORIGIN=*

# Database path (SQLite). Defaults to ./data/video-pipeline.db
DB_PATH=

# ---------------------------------------------------------------
# Platform credentials. Real adapters read these to upload.
# Leave unset to run platform adapters in "simulated" mode,
# which produces realistic sample URLs + metrics for development.
# ---------------------------------------------------------------

# YouTube Data API v3 (server-side OAuth / API key)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# YouTube upload. Read directly by the adapter (not via config) and required
# for a REAL YouTube publish; without it the adapter records a retryable
# YT_UPLOAD_TOKEN_MISSING error in cycle.errors instead of publishing.
YOUTUBE_UPLOAD_TOKEN=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
